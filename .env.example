# Copy to .env for local Docker Compose. Never commit .env or real credentials.
# All values below are non-production placeholders.
QF_ENV=local
QF_ENVIRONMENT=local
QF_GIT_COMMIT=local-worktree
QF_BUILD_ID=local-dev
QF_POSTGRES_DB=quantfoundry
QF_POSTGRES_USER=quantfoundry
QF_POSTGRES_PASSWORD=change-me-before-use
# Use a URL-safe local password. Compose derives QF_DATABASE_URL and
# QF_ALEMBIC_URL from these three values so application and migrations cannot drift.

# Local single-host storage baseline. S3-compatible storage is an extension, not
# a required V1 service; leave endpoint/credentials unset unless its adapter exists.
QF_ARTIFACT_ROOT=/var/lib/quantfoundry/artifacts
QF_DATA_ROOT=/var/lib/quantfoundry/data

# Local-only deterministic OpenAI-compatible service plus deterministic data
# adapter. These values are development credentials, not external-provider
# credentials, and must never be reused outside local/development.
QF_AGENT_PROVIDER=openai-compatible
QF_AGENT_MODEL=qf-local-v1
QF_OPENAI_BASE_URL=http://local-provider:8011/v1
QF_OPENAI_MODELS=qf-local-v1
QF_OPENAI_DISPLAY_NAME=QuantFoundry local deterministic provider
QF_LOCAL_PROVIDER_API_KEY=local-development-provider-key-not-a-secret
QF_LOCAL_DATA_CREDENTIAL=local-development-data-key-not-a-secret
QF_ENABLE_LOCAL_DETERMINISTIC_PROVIDER=1

# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '\n'
QF_CREDENTIAL_ENCRYPTION_KEY_ID=local-key-v1
QF_CREDENTIAL_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key

# Application secrets must be injected out of band for any non-local deployment.
# Do not put provider credentials, bearer signing keys, or production secrets here.
QF_LOG_LEVEL=INFO
