{
  "name": "quantfoundry-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.19.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "bundle:check": "node scripts/check-bundle.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "public-id:check": "node scripts/check-public-id-fixtures.mjs",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "ci": "pnpm codegen:check && pnpm public-id:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build && pnpm bundle:check && pnpm storybook:build",
    "codegen": "openapi-typescript ../docs/后端系统技术方案/contracts/openapi-v1.yaml -o src/api/generated.ts && node scripts/generate-runtime-schemas.mjs && node scripts/generate-operation-map.mjs",
    "codegen:check": "openapi-typescript ../docs/后端系统技术方案/contracts/openapi-v1.yaml -o src/api/generated.ts --check && node scripts/generate-runtime-schemas.mjs --check && node scripts/generate-operation-map.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@vitejs/plugin-react": "6.0.5",
    "echarts": "6.1.0",
    "i18next": "26.3.6",
    "openapi-typescript": "7.13.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "js-yaml": "4.3.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.5.7",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
