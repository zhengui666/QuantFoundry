FROM mirror.gcr.io/library/node:24.19.0-alpine3.23@sha256:244cc2b53f46f9e876304391d17682b0ddae9ac33491f4857e25e35a36ba7995 AS build
ARG QF_GIT_COMMIT=unknown
ARG QF_BUILD_ID=unknown
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM mirror.gcr.io/nginxinc/nginx-unprivileged:1.29.1-alpine@sha256:27985295bdb22a1ef8f712863210bd5877c0f3006494a593e86b3fe0fa55467e
ARG QF_GIT_COMMIT=unknown
ARG QF_BUILD_ID=unknown
LABEL org.opencontainers.image.revision=$QF_GIT_COMMIT \
      org.opencontainers.image.version=$QF_BUILD_ID
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
