FROM mirror.gcr.io/library/python:3.14.0-slim-trixie@sha256:0aecac02dc3d4c5dbb024b753af084cafe41f5416e02193f1ce345d671ec966e AS runtime

ARG QF_GIT_COMMIT=unknown
ARG QF_BUILD_ID=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/workspace/backend/src:/workspace/backend \
    PATH=/opt/venv/bin:$PATH

RUN groupadd --system quantfoundry \
    && useradd --system --gid quantfoundry --home-dir /app --create-home \
        --shell /usr/sbin/nologin quantfoundry \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive \
        apt-get install --yes --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv==0.10.7

WORKDIR /workspace/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --no-cache
COPY --chown=quantfoundry:quantfoundry backend/ ./
COPY --chown=quantfoundry:quantfoundry docs/后端系统技术方案/QuantFoundry_Backend_System_Technical_Design_V1.0.0.md /workspace/docs/后端系统技术方案/
COPY --chown=quantfoundry:quantfoundry docs/后端系统技术方案/contracts/ /workspace/docs/后端系统技术方案/contracts/
COPY --chown=quantfoundry:quantfoundry scripts/bootstrap_local.py scripts/bootstrap_owner.py scripts/bootstrap_result_check.py scripts/fullstack_seed.py scripts/api_healthcheck.py scripts/runtime_healthcheck.py /workspace/scripts/
RUN mkdir -p /var/lib/quantfoundry/artifacts /var/lib/quantfoundry/data /workspace/scripts \
    && chown -R quantfoundry:quantfoundry /var/lib/quantfoundry /workspace

LABEL org.opencontainers.image.revision=$QF_GIT_COMMIT \
      org.opencontainers.image.version=$QF_BUILD_ID

USER quantfoundry
EXPOSE 8000
